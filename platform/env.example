# Copy these four names into Vercel (Project → Settings → Environment Variables).
# The values come from your Supabase project (Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=the "publishable" (anon) key
SUPABASE_SERVICE_ROLE_KEY=the "secret" (service role) key. Never share this one.
ADMIN_EMAILS=your-email@example.com
